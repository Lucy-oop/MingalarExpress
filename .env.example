# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS. Never import this into a client component --
# lib/supabase/admin.ts is marked 'server-only' to make that a build error.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Map provider (pluggable -- see lib/map/providers.ts)
#   dev  : osm         -- raw tile.openstreetmap.org, no key, rate limited
#   prod : maptiler | stadia | geoapify | self_hosted
#
# OSM's tile server and public Nominatim forbid heavy use and cap Nominatim at
# 1 req/sec. Switch provider before launch, not after the first traffic spike.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_MAP_PROVIDER=osm
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_API_KEY=

# ---------------------------------------------------------------------------
# Geocoder -- configured SEPARATELY from tiles. They are different products
# even from the same vendor, and mixing them is normal (MapTiler tiles with a
# self-hosted Nominatim, say).
#
#   nominatim   -- public instance. Dev only: 1 req/sec, policy forbids
#                  production use.
#   maptiler    -- needs NEXT_PUBLIC_GEOCODER_API_KEY, or reuses
#                  NEXT_PUBLIC_MAP_API_KEY.
#   self_hosted -- your own Nominatim. Set the base URL; a sub-path is fine.
#   geoapify    -- allowed by the DB CHECK, NOT implemented. Falls back to
#                  Nominatim with a console error.
#
# Leave the base URL blank to use the provider's own default. A base URL that
# does not match the provider is ignored (with a console error) rather than
# used -- a leftover Nominatim URL under maptiler would 404 forever and just
# silently stop autofilling the address field.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GEOCODER_PROVIDER=nominatim
NEXT_PUBLIC_GEOCODER_BASE_URL=
NEXT_PUBLIC_GEOCODER_API_KEY=

# Nominatim's policy REQUIRES a contactable identifier -- but `User-Agent` is a
# forbidden header name, so a browser fetch cannot send it. Honouring that
# policy needs a server-side proxy; this value is kept for when one exists.
NEXT_PUBLIC_GEOCODER_USER_AGENT="MingalarExpress/0.1 (ops@mingalar.example)"

# ---------------------------------------------------------------------------
# Thingangyun Township defaults
# ---------------------------------------------------------------------------
NEXT_PUBLIC_DEFAULT_CENTER_LAT=16.8409
NEXT_PUBLIC_DEFAULT_CENTER_LNG=96.1735
NEXT_PUBLIC_DEFAULT_ZOOM=14
